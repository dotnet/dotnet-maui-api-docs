    <Member MemberName="BadgeText">
      <MemberSignature Language="C#" Value="public string BadgeText { get; set; }" />
      <MemberSignature Language="ILAsm" Value=".property instance string BadgeText" />
      <MemberSignature Language="DocId" Value="P:Microsoft.Maui.Controls.ToolbarItem.BadgeText" />
      <MemberSignature Language="VB.NET" Value="Public Property BadgeText As String" />
